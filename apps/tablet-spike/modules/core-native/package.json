{
  "name": "@lumik/core-native",
  "version": "0.0.0",
  "private": true,
  "description": "Puente uniffi de lumik-core (spike)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everitosan/lumik.git"
  },
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "ubrn:android": "ubrn build android --and-generate --config ubrn.config.yaml",
    "ubrn:clean": "rm -rf cpp/ android/ ios/ src/ Native*.podspec"
  },
  "dependencies": {
    "uniffi-bindgen-react-native": "0.31.0-6",
    "@ubjs/core": "0.31.0-6"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "react-native-builder-bob": "^0.44.1"
  },
  "codegenConfig": {
    "name": "NativeCoreNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.lumik.corenative"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
